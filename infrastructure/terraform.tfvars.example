subscription_id    = "YOUR-SUBSCRIPTION-ID"
prefix             = "aksintro-jk01"
location           = "swedencentral"
node_vm_size       = "Standard_D4as_v7"
# Verify 1.35.1 is still available with standard support in the region before using it.
# Otherwise choose the oldest available supported patch >=1.35.0, excluding previews/LTS-only.
# Confirm a newer supported upgrade is available for Lab 2.
kubernetes_version = "1.35.1"

# Set true only when the instructor confirms the training subscription's approved policy exemption.
# allow_storage_policy_exemption = true

# Set to true when starting Lab 3; keep enabled until AGC cleanup completes.
enable_agc = false

# Enable each feature when reaching that lab; keep prior inputs and state.
enable_blob_storage         = false
enable_argocd               = false
enable_monitoring_resources = false

# Required for Labs 4 and 7: az ad signed-in-user show --query id -o tsv
# attendee_object_id = "YOUR-USER-OBJECT-ID"

# Optional for Lab 4; otherwise a stable account name is generated.
# storage_account_name = "YOUR-UNIQUE-ACCOUNT-NAME"

# Required for Lab 6 after creating the Entra app and group outside Terraform.
# argocd_sso_client_id   = "YOUR-APP-CLIENT-ID"
# argocd_group_object_id = "YOUR-GROUP-OBJECT-ID"

# Lab 7: copy the output here only AFTER CLI monitoring onboarding.
# log_analytics_workspace_id = "YOUR-WORKSPACE-RESOURCE-ID"
